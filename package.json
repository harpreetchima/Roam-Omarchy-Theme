{
  "name": "roam-omarchy-theme",
  "version": "1.0.0",
  "description": "Device-local Omarchy palettes for Blueprint in Roam Research",
  "main": "src/index.ts",
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:browser": "node --test tests/browser-protocol.test.cjs",
    "test:native": "/usr/bin/python3 -m unittest discover -s tests -p 'test_native*.py'",
    "build": "webpack",
    "watch": "webpack --watch",
    "start": "webpack --watch",
    "add_css": "sh add_css.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react-color": "^3.0.13",
    "react-color": "^2.19.3",
    "roamjs-scripts": "^0.27.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "gulp": "^5.0.1",
    "roamjs-components": "^0.90.0"
  }
}
